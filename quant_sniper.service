[Unit]
Description=Kiwoom Quant Sniper Trading Bot Daemon
After=network.target

[Service]
Type=simple
User=niphyang
WorkingDirectory=/home/niphyang/quant-sniper
EnvironmentFile=/home/niphyang/quant-sniper/.env
ExecStart=/usr/bin/python3 /home/niphyang/quant-sniper/bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
