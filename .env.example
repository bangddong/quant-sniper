# 키움증권 REST API 설정
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here
KIWOOM_ACCOUNT_NO=your_account_number_here

# 실전 주문은 명시적으로 활성화해야 합니다.
LIVE_TRADING_ENABLED=false
ORDER_CONFIRM_TIMEOUT_SECONDS=20

# 공개 저장소에서는 보유·체결 정보도 공개되므로 기본 비활성화합니다.
AUTO_GIT_PUSH=false

# ===== Coin Sniper (Binance 현물 봇) =====
# MODE: demo(기본) 또는 live. live는 COIN_LIVE_TRADING_ENABLED=true 도 필요합니다.
# (위의 LIVE_TRADING_ENABLED는 주식 봇 전용이며 코인 봇은 보지 않습니다.)
MODE=demo
COIN_LIVE_TRADING_ENABLED=false
BINANCE_DEMO_API_KEY=your_demo_api_key
BINANCE_DEMO_API_SECRET=your_demo_api_secret
BINANCE_LIVE_API_KEY=your_live_api_key
BINANCE_LIVE_API_SECRET=your_live_api_secret
STARTING_CAPITAL_USDT=1000
# 데모 전용: true면 BTC 시장 필터를 건너뛴다(하락장에서도 주문 흐름 확인용). live에서는 시작 거부.
COIN_DEMO_IGNORE_MARKET_FILTER=false
# 전략: breakout(일봉 돌파·RSI, 기본) | trend(BTC·ETH 주간 추세). docs/coin-sniper.md 「추세 전략」
COIN_STRATEGY=breakout
